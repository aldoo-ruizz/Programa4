@page "/usuarios"
@rendermode InteractiveServer
@inject IUsuarioService ServicioUsuarios
@inject ITipoUsuarioService ServicioTiposUsuario
@inject ILogger<ListadoUsuarios> Registro

<PageTitle>Usuarios registrados</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Usuarios registrados</h1>
        <p class="text-muted mb-0">Consulta, edita y elimina los usuarios del sistema.</p>
    </div>
    <a class="btn btn-primary" href="usuarios/nuevo">+ Nuevo usuario</a>
</div>

@if (!string.IsNullOrWhiteSpace(mensajeExito))
{
    <Alerta Tipo="success" Titulo="Operación exitosa" Mensaje="@mensajeExito" OnCerrar="LimpiarExito" />
}

@if (!string.IsNullOrWhiteSpace(mensajeError))
{
    <Alerta Tipo="danger" Titulo="Ocurrió un problema" Mensaje="@mensajeError" OnCerrar="LimpiarError" />
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label" for="textoBusqueda">Buscar usuario</label>
                <input id="textoBusqueda" type="search" class="form-control"
                       placeholder="Nombre, apellido o correo"
                       @bind="filtro.Texto" @bind:event="oninput"
                       @onkeydown="ManejarTeclaIngreso" />
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label" for="filtroTipo">Tipo de usuario</label>
                <select id="filtroTipo" class="form-select" @bind="tipoSeleccionado">
                    <option value="0">Todos los tipos</option>
                    @foreach (var tipo in tiposUsuario)
                    {
                        <option value="@tipo.TipoUsuarioId">@tipo.Nombre</option>
                    }
                    <option value="-1">Sin tipo asignado</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label" for="filtroEstatus">Estatus</label>
                <select id="filtroEstatus" class="form-select" @bind="filtroEstatus">
                    <option value="todos">Todos</option>
                    <option value="activos">Solo activos</option>
                    <option value="inactivos">Solo inactivos</option>
                </select>
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="button" class="btn btn-primary flex-fill" @onclick="BuscarAsync">Buscar</button>
                <button type="button" class="btn btn-outline-secondary flex-fill" @onclick="LimpiarFiltrosAsync">
                    Limpiar
                </button>
            </div>
        </div>
    </div>
</div>

@if (cargando)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span>Cargando usuarios…</span>
    </div>
}
else if (resultado.EstaVacio)
{
    <div class="alert alert-info" role="alert">
        No se encontraron usuarios con los criterios seleccionados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Nombre completo</th>
                    <th scope="col">Correo</th>
                    <th scope="col">Teléfono</th>
                    <th scope="col">Fecha de nacimiento</th>
                    <th scope="col" class="text-center">Edad</th>
                    <th scope="col">Tipo de usuario</th>
                    <th scope="col" class="text-center">Estatus</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in resultado.Elementos)
                {
                    <tr>
                        <td>@usuario.UsuarioId</td>
                        <td>@usuario.NombreCompleto</td>
                        <td><a href="mailto:@usuario.Correo">@usuario.Correo</a></td>
                        <td>@(string.IsNullOrWhiteSpace(usuario.Telefono) ? "—" : usuario.Telefono)</td>
                        <td>@usuario.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">@usuario.Edad</td>
                        <td>
                            <span class="badge @(usuario.TipoUsuarioId.HasValue ? "text-bg-primary" : "text-bg-light border text-dark")">
                                @usuario.TipoUsuarioMostrar
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="badge @(usuario.Activo ? "text-bg-success" : "text-bg-secondary")">
                                @(usuario.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               href="@($"usuarios/editar/{usuario.UsuarioId}")">Editar</a>
                            <button type="button" class="btn btn-sm btn-outline-danger ms-1"
                                    @onclick="() => SolicitarEliminacion(usuario)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Paginador Pagina="resultado.Pagina"
               TotalPaginas="resultado.TotalPaginas"
               TotalRegistros="resultado.TotalRegistros"
               OnCambiarPagina="CambiarPaginaAsync" />
}

<ModalConfirmacion Visible="@(usuarioPorEliminar is not null)"
                   Titulo="Eliminar usuario"
                   Mensaje="@($"¿Confirma que desea eliminar al usuario {usuarioPorEliminar?.NombreCompleto}? Esta acción no se puede deshacer.")"
                   TextoConfirmar="Eliminar"
                   Procesando="eliminando"
                   OnConfirmar="ConfirmarEliminacionAsync"
                   OnCancelar="CancelarEliminacion" />

@code {
    private readonly UsuarioFiltroDto filtro = new();

    private ResultadoPaginado<UsuarioDto> resultado = ResultadoPaginado<UsuarioDto>.Vacio(10);
    private IReadOnlyList<TipoUsuarioDto> tiposUsuario = Array.Empty<TipoUsuarioDto>();
    private UsuarioDto? usuarioPorEliminar;
    private bool cargando = true;
    private bool eliminando;
    private string? mensajeExito;
    private string? mensajeError;

    /// <summary>Mensaje de confirmación recibido como parámetro de consulta.</summary>
    [SupplyParameterFromQuery(Name = "mensaje")]
    public string? MensajeInicial { get; set; }

    /// <summary>Enlace del filtro de estatus con el combo de la vista.</summary>
    private string filtroEstatus
    {
        get => filtro.Activo switch
        {
            true => "activos",
            false => "inactivos",
            _ => "todos"
        };
        set => filtro.Activo = value switch
        {
            "activos" => true,
            "inactivos" => false,
            _ => null
        };
    }

    /// <summary>
    /// Enlace del filtro de tipo de usuario: 0 = todos, -1 = sin tipo asignado,
    /// valor positivo = identificador del tipo.
    /// </summary>
    private int tipoSeleccionado
    {
        get
        {
            if (filtro.SoloSinTipoAsignado)
            {
                return -1;
            }

            return filtro.TipoUsuarioId ?? 0;
        }
        set
        {
            filtro.SoloSinTipoAsignado = value < 0;
            filtro.TipoUsuarioId = value > 0 ? value : null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(MensajeInicial))
        {
            mensajeExito = MensajeInicial;
        }

        await CargarTiposUsuarioAsync();
        await CargarUsuariosAsync();
    }

    private async Task CargarTiposUsuarioAsync()
    {
        try
        {
            var listado = await ServicioTiposUsuario.ObtenerListadoAsync(
                new TipoUsuarioFiltroDto { TamanoPagina = 100 });

            tiposUsuario = listado.Elementos
                .OrderByDescending(tipo => tipo.Activo)
                .ThenBy(tipo => tipo.Nombre)
                .ToList();
        }
        catch (Exception excepcion)
        {
            Registro.LogError(excepcion, "Error al cargar el catálogo de tipos de usuario para el filtro.");
        }
    }

    private async Task CargarUsuariosAsync()
    {
        cargando = true;

        try
        {
            resultado = await ServicioUsuarios.ObtenerListadoAsync(filtro);
        }
        catch (Exception excepcion)
        {
            Registro.LogError(excepcion, "Error al consultar el listado de usuarios.");
            mensajeError = "No fue posible consultar el listado de usuarios.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarAsync()
    {
        filtro.Pagina = 1;
        await CargarUsuariosAsync();
    }

    private async Task LimpiarFiltrosAsync()
    {
        filtro.Texto = null;
        filtro.Activo = null;
        filtro.TipoUsuarioId = null;
        filtro.SoloSinTipoAsignado = false;
        filtro.Pagina = 1;
        await CargarUsuariosAsync();
    }

    private async Task CambiarPaginaAsync(int pagina)
    {
        filtro.Pagina = pagina;
        await CargarUsuariosAsync();
    }

    private async Task ManejarTeclaIngreso(KeyboardEventArgs argumentos)
    {
        if (string.Equals(argumentos.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            await BuscarAsync();
        }
    }

    private void SolicitarEliminacion(UsuarioDto usuario)
    {
        usuarioPorEliminar = usuario;
        mensajeError = null;
        mensajeExito = null;
    }

    private void CancelarEliminacion() => usuarioPorEliminar = null;

    private async Task ConfirmarEliminacionAsync()
    {
        if (usuarioPorEliminar is null)
        {
            return;
        }

        var usuarioId = usuarioPorEliminar.UsuarioId;
        eliminando = true;

        try
        {
            var operacion = await ServicioUsuarios.EliminarAsync(usuarioId);

            if (operacion.Exito)
            {
                mensajeExito = operacion.Mensaje;
                usuarioPorEliminar = null;
                await CargarUsuariosAsync();
            }
            else
            {
                mensajeError = operacion.Mensaje;
                usuarioPorEliminar = null;
            }
        }
        catch (Exception excepcion)
        {
            Registro.LogError(excepcion, "Error al eliminar el usuario {UsuarioId}.", usuarioId);
            mensajeError = "No fue posible eliminar al usuario seleccionado.";
            usuarioPorEliminar = null;
        }
        finally
        {
            eliminando = false;
        }
    }

    private void LimpiarExito() => mensajeExito = null;

    private void LimpiarError() => mensajeError = null;
}
