@page "/tipos-usuario"
@rendermode InteractiveServer
@inject ITipoUsuarioService ServicioTiposUsuario
@inject ILogger<ListadoTiposUsuario> Registro

<PageTitle>Tipos de usuario</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Tipos de usuario</h1>
        <p class="text-muted mb-0">Catálogo de perfiles disponibles para clasificar a los usuarios del sistema.</p>
    </div>
    <a class="btn btn-primary" href="tipos-usuario/nuevo">+ Nuevo tipo de usuario</a>
</div>

@if (!string.IsNullOrWhiteSpace(mensajeExito))
{
    <Alerta Tipo="success" Titulo="Operación exitosa" Mensaje="@mensajeExito" OnCerrar="LimpiarExito" />
}

@if (!string.IsNullOrWhiteSpace(mensajeError))
{
    <Alerta Tipo="danger" Titulo="Ocurrió un problema" Mensaje="@mensajeError" OnCerrar="LimpiarError" />
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6">
                <label class="form-label" for="textoBusqueda">Buscar tipo de usuario</label>
                <input id="textoBusqueda" type="search" class="form-control"
                       placeholder="Nombre o descripción"
                       @bind="filtro.Texto" @bind:event="oninput"
                       @onkeydown="ManejarTeclaIngreso" />
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label" for="filtroEstatus">Estatus</label>
                <select id="filtroEstatus" class="form-select" @bind="filtroEstatus">
                    <option value="todos">Todos</option>
                    <option value="activos">Solo activos</option>
                    <option value="inactivos">Solo inactivos</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-3 d-flex gap-2">
                <button type="button" class="btn btn-primary flex-fill" @onclick="BuscarAsync">Buscar</button>
                <button type="button" class="btn btn-outline-secondary flex-fill" @onclick="LimpiarFiltrosAsync">
                    Limpiar
                </button>
            </div>
        </div>
    </div>
</div>

@if (cargando)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span>Cargando tipos de usuario…</span>
    </div>
}
else if (resultado.EstaVacio)
{
    <div class="alert alert-info" role="alert">
        No se encontraron tipos de usuario con los criterios seleccionados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Descripción</th>
                    <th scope="col" class="text-center">Usuarios asignados</th>
                    <th scope="col" class="text-center">Estatus</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tipo in resultado.Elementos)
                {
                    <tr>
                        <td>@tipo.TipoUsuarioId</td>
                        <td class="fw-semibold">@tipo.Nombre</td>
                        <td>@tipo.DescripcionMostrar</td>
                        <td class="text-center">
                            <span class="badge @(tipo.TieneUsuariosAsignados ? "text-bg-primary" : "text-bg-light border text-dark")">
                                @tipo.UsuariosAsignados
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="badge @(tipo.Activo ? "text-bg-success" : "text-bg-secondary")">
                                @tipo.Estatus
                            </span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               href="@($"tipos-usuario/editar/{tipo.TipoUsuarioId}")">Editar</a>
                            <button type="button" class="btn btn-sm btn-outline-danger ms-1"
                                    title="@(tipo.TieneUsuariosAsignados ? "No se puede eliminar: tiene usuarios asignados." : "Eliminar tipo de usuario")"
                                    @onclick="() => SolicitarEliminacion(tipo)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Paginador Pagina="resultado.Pagina"
               TotalPaginas="resultado.TotalPaginas"
               TotalRegistros="resultado.TotalRegistros"
               OnCambiarPagina="CambiarPaginaAsync" />
}

<ModalConfirmacion Visible="@(tipoPorEliminar is not null)"
                   Titulo="Eliminar tipo de usuario"
                   Mensaje="@MensajeEliminacion"
                   TextoConfirmar="Eliminar"
                   Procesando="eliminando"
                   OnConfirmar="ConfirmarEliminacionAsync"
                   OnCancelar="CancelarEliminacion" />

@code {
    private readonly TipoUsuarioFiltroDto filtro = new();

    private ResultadoPaginado<TipoUsuarioDto> resultado = ResultadoPaginado<TipoUsuarioDto>.Vacio(10);
    private TipoUsuarioDto? tipoPorEliminar;
    private bool cargando = true;
    private bool eliminando;
    private string? mensajeExito;
    private string? mensajeError;

    /// <summary>Mensaje de confirmación recibido como parámetro de consulta.</summary>
    [SupplyParameterFromQuery(Name = "mensaje")]
    public string? MensajeInicial { get; set; }

    /// <summary>Enlace del filtro de estatus con el combo de la vista.</summary>
    private string filtroEstatus
    {
        get => filtro.Activo switch
        {
            true => "activos",
            false => "inactivos",
            _ => "todos"
        };
        set => filtro.Activo = value switch
        {
            "activos" => true,
            "inactivos" => false,
            _ => null
        };
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(MensajeInicial))
        {
            mensajeExito = MensajeInicial;
        }

        await CargarTiposUsuarioAsync();
    }

    private async Task CargarTiposUsuarioAsync()
    {
        cargando = true;

        try
        {
            resultado = await ServicioTiposUsuario.ObtenerListadoAsync(filtro);
        }
        catch (Exception excepcion)
        {
            Registro.LogError(excepcion, "Error al consultar el catálogo de tipos de usuario.");
            mensajeError = "No fue posible consultar el catálogo de tipos de usuario.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarAsync()
    {
        filtro.Pagina = 1;
        await CargarTiposUsuarioAsync();
    }

    private async Task LimpiarFiltrosAsync()
    {
        filtro.Texto = null;
        filtro.Activo = null;
        filtro.Pagina = 1;
        await CargarTiposUsuarioAsync();
    }

    private async Task CambiarPaginaAsync(int pagina)
    {
        filtro.Pagina = pagina;
        await CargarTiposUsuarioAsync();
    }

    private async Task ManejarTeclaIngreso(KeyboardEventArgs argumentos)
    {
        if (string.Equals(argumentos.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            await BuscarAsync();
        }
    }

    private void SolicitarEliminacion(TipoUsuarioDto tipo)
    {
        tipoPorEliminar = tipo;
        mensajeError = null;
        mensajeExito = null;
    }

    /// <summary>Mensaje de confirmación de la eliminación, considerando los usuarios asignados.</summary>
    private string MensajeEliminacion =>
        tipoPorEliminar is null
            ? string.Empty
            : tipoPorEliminar.TieneUsuariosAsignados
                ? $"El tipo de usuario {tipoPorEliminar.Nombre} tiene {tipoPorEliminar.UsuariosAsignados} "
                  + "usuario(s) asignado(s) y no puede eliminarse. Desactive el tipo o reasigne a los usuarios."
                : $"¿Confirma que desea eliminar el tipo de usuario {tipoPorEliminar.Nombre}? "
                  + "Esta acción no se puede deshacer.";

    private void CancelarEliminacion() => tipoPorEliminar = null;

    private async Task ConfirmarEliminacionAsync()
    {
        if (tipoPorEliminar is null)
        {
            return;
        }

        var tipoUsuarioId = tipoPorEliminar.TipoUsuarioId;
        eliminando = true;

        try
        {
            var operacion = await ServicioTiposUsuario.EliminarAsync(tipoUsuarioId);

            if (operacion.Exito)
            {
                mensajeExito = operacion.Mensaje;
                tipoPorEliminar = null;
                await CargarTiposUsuarioAsync();
            }
            else
            {
                mensajeError = operacion.Mensaje;
                tipoPorEliminar = null;
            }
        }
        catch (Exception excepcion)
        {
            Registro.LogError(excepcion, "Error al eliminar el tipo de usuario {TipoUsuarioId}.", tipoUsuarioId);
            mensajeError = "No fue posible eliminar el tipo de usuario seleccionado.";
            tipoPorEliminar = null;
        }
        finally
        {
            eliminando = false;
        }
    }

    private void LimpiarExito() => mensajeExito = null;

    private void LimpiarError() => mensajeError = null;
}

